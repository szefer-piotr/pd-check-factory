{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pd-check-factory/schemas/protocol_enrichment_v1.schema.json",
  "title": "Protocol enrichment artifact V1",
  "type": "object",
  "required": ["schema_version", "study_id", "deviation_id", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "study_id": { "type": "string", "minLength": 1 },
    "deviation_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "enrichment_status": { "type": "string", "enum": ["ok", "partial", "failed"] },
    "enrichment_summary": { "type": "string" },
    "enrichment_errors": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "logic": { "type": "object" },
    "caveats": { "type": "object" },
    "critique": { "type": "object" },
    "merged": {
      "type": "object",
      "properties": {
        "improved_deviation_text": { "type": "string" },
        "improved_pseudo_logic_plain_english": { "type": "string" },
        "paragraph_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^p[0-9]+$" }
        },
        "data_support_note": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "caveats": { "type": "array", "items": { "type": "string" } },
        "data_gaps": { "type": "array", "items": { "type": "string" } },
        "required_datasets": { "type": "array", "items": { "type": "string" } },
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "weak_spots": { "type": "array", "items": { "type": "string" } },
        "suggested_changes": { "type": "array", "items": { "type": "string" } },
        "protocol_conflicts": { "type": "array", "items": { "type": "string" } },
        "programmability_risk": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    }
  },
  "additionalProperties": false
}
