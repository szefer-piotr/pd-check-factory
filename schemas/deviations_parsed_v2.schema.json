{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pd-check-factory/schemas/deviations_parsed_v2.schema.json",
  "title": "Parsed deviations V2",
  "type": "object",
  "required": ["schema_version", "study_id", "generated_at", "deviations"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0", "1.1.0"] },
    "study_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "import_version": { "type": "string" },
    "source_type": { "type": "string", "enum": ["import", "merged"] },
    "pd_spec_import_mode": {
      "type": "string",
      "enum": ["map", "enrich_stub", "enrich", "ground"]
    },
    "partial": { "type": "boolean" },
    "completed_rule_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deviation_id", "rule_id", "text", "paragraph_refs"],
        "properties": {
          "deviation_id": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "paragraph_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^p[0-9]+$" }
          },
          "data_support_note": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "accepted", "to_review", "rejected"] },
          "dm_comment": { "type": "string" },
          "original_deviation_text": { "type": "string" },
          "suggested_deviation_text": { "type": "string" },
          "pd_spec_import": {
            "type": "object",
            "properties": {
              "entry_source": {
                "type": "string",
                "enum": ["extracted", "imported", "imported_pd_spec"]
              },
              "protocol_deviation_category": { "type": "string" },
              "protocol_deviation_sub_category": { "type": "string" },
              "classification": { "type": "string" },
              "data_source": { "type": "string" },
              "manual_or_programmable": { "type": "string" },
              "programming_status": { "type": "string" },
              "programmer_comments": { "type": "string" },
              "reviewer_comments": { "type": "string" },
              "aa_comment": { "type": "string" },
              "grounding_error": { "type": "string" },
              "occurrence_date": { "type": "string" },
              "additional_information": { "type": "string" },
              "pseudo_logic_seed": { "type": "string" },
              "enrichment_status": { "type": "string", "enum": ["ok", "partial", "failed"] },
              "enrichment_summary": { "type": "string" }
            },
            "additionalProperties": true
          },
          "merge_action": { "type": "string", "enum": ["keep", "update", "add"] },
          "merge_source_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
